#!name=BlockAds 去重补充
#!desc=配合2026-09-10版blockAds使用：保留AllInOne、HTTPDNS及YouTube未覆盖内容。安装后停用原AllInOne、HTTPDNS、YouTube Enhance、广告联盟。静态去重及接口排除；尚待手机实测。
#!author=原规则 blackmatrix7、fmz200、可莉、VirgilClyne、Maasea；本文件为本地去重整理
#!arguments=屏蔽上传按钮:true,屏蔽选段按钮:true,屏蔽Shorts按钮:false,字幕翻译语言:off,启用调试模式:false
#!arguments-desc=YouTube参数仅传给补充接口；合集已覆盖接口仍由blockAds处理，独立Enhance的参数不会完整生效。
# 基准 SHA256：37d93d7150ab77843adba9b2d8ece50c58832c05c3b66ed822e843311fdf4c5f
# 本地补充无远程更新地址；blockAds更新后需要重新比对。
# 复杂正则采用同服务接口的排除条件，优先交给blockAds处理；不能证明任意正则之间完全不重叠。
# 来源：用户上传的 AllInOne.sgmodule、blockHTTPDNS.module、YouTube.Enhance.sgmodule、AffiliateMarketing.sgmodule。
# 上游：https://github.com/blackmatrix7/ios_rule_script
# 上游：https://github.com/fmz200/wool_scripts
# 上游：https://github.com/Maasea/sgmodule

[General]
force-http-engine-hosts = %APPEND% *.ott.cibntv.net,intl.iqiyi.com,maicai.api.ddxq.mobi,mobileapi-v6.elong.com,weibointl.api.weibo.cn,wmapi.meituan.com

[Rule]
# 来源：AllInOne.sgmodule
DOMAIN,apm.zhihu.com,REJECT
# 来源：AllInOne.sgmodule
DOMAIN,duga.zhihu.com,REJECT
# 来源：AllInOne.sgmodule
